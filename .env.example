# Copiá este archivo a .env y completá lo que necesites. Nunca commitees el .env.

# ── Base de datos ───────────────────────────────────────────────────────────
# SQLite local (se crea sola). Para Postgres/Supabase ver docs/data-layer.md.
DATABASE_URL="file:./data/app.db"

# ── Ninox (integración de terceros) ─────────────────────────────────────────
# test | prod. El token lo da Ninox al dar de alta la integración. Nunca lo commitees.
NINOX_ENV=test
NINOX_TOKEN=
# Opcional: URL propia (API local o proxy). Si está, pisa la de NINOX_ENV.
# NINOX_BASE_URL=
# NINOX_TIMEOUT_MS=30000
# La app confía en los certificados raíz del sistema operativo además de los de Node
# (servidores con certificado propio, proxies corporativos). Para desactivarlo:
# TLS_USE_SYSTEM_CA=false
# Minutos entre sincronizaciones automáticas del catálogo (mínimo 10).
# CATALOG_SYNC_MINUTES=15

# ── Admin ───────────────────────────────────────────────────────────────────
# Clave del panel /admin y secreto para firmar la cookie de sesión (32+ caracteres al azar).
ADMIN_PASSWORD=
SESSION_SECRET=

# ── Tareas programadas ──────────────────────────────────────────────────────
# Secreto para POST /api/cron/ninox (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=
# true: el proceso Node corre el despacho y el sync solo (Azure App Service, VM, Docker).
# En Vercel/Netlify dejalo en false y usá el cron de la plataforma.
# RUN_SCHEDULER=false
